generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"
  url = env("DATABASE_URL") }
enum Status { PENDING APPROVED REJECTED NEEDS_CHANGES FLAGGED }
enum MediaType { IMAGE AUDIO VIDEO TEXT }
enum Role { USER ADMIN MODERATOR }
model User {
  id String @id @default(cuid())
  email String @unique
  password String
  role Role @default(USER)
  createdAt DateTime @default(now())
  contributions Contributor[]
  approved Submission[] @relation("approver")
  moderations ModerationAction[] }
model Submission {
  id String @id @default(cuid())
  slug String @unique
  title String
  description String?
  content String
  categoryId String
  stateId String
  districtId String?
  languageId String?
  contributorId String
  status Status @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  approvedAt DateTime?
  approvedById String?
  category Category @relation(fields: [categoryId], references: [id])
  state State @relation(fields: [stateId], references: [id])
  district District? @relation(fields: [districtId], references: [id])
  language Language? @relation(fields: [languageId], references: [id])
  contributor Contributor @relation(fields: [contributorId], references: [id])
  approvedBy User? @relation("approver", fields: [approvedById], references: [id])
  media Media[]
  tags SubmissionTag[]
  moderations ModerationAction[]
  flags Flag[]
  views View[] }
model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  submissions Submission[] }
model State {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  districts District[]
  submissions Submission[] }
model District {
  id String @id @default(cuid())
  name String
  slug String @unique
  stateId String
  state State @relation(fields: [stateId], references: [id])
  submissions Submission[] }
model Language {
  id String @id @default(cuid())
  name String @unique
  code String @unique
  submissions Submission[] }
